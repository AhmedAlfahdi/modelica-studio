{
  "name": "modelica-studio",
  "version": "0.3.21",
  "description": "Obsidian plugin for visual Modelica modeling and simulation. Beta.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "node --test test/*.test.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "lint": "eslint src"
  },
  "author": "Ahmed N. Alfahdi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhmedAlfahdi/modelica-studio.git"
  },
  "keywords": [
    "obsidian",
    "modelica",
    "simulation"
  ],
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1"
  }
}
